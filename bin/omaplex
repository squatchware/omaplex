#!/usr/bin/env bash
# omaplex launcher.
#   omaplex                launch, or focus the TV if it's already on
#   omaplex toggle         launch / stash in special:omaplex / bring back to this workspace
#   omaplex reload-theme   repaint the running TV from the current Omarchy theme
#   omaplex setup          add the Hyprland rule, keybinding and theme hook (--remove to undo)
set -euo pipefail
dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
state="$HOME/.config/omaplex/state.json"

# A checkout uses its own node_modules; the Arch package uses the system electron.
electron="${OMAPLEX_ELECTRON:-}"
if [[ -z $electron ]]; then
  if [[ -x $dir/node_modules/.bin/electron ]]; then
    electron="$dir/node_modules/.bin/electron"
  else
    electron="$(command -v electron || true)"
  fi
fi

case ${1:-} in
  setup)
    [[ ${2:-} == --remove ]] && exec "$dir/install.sh" --uninstall
    exec "$dir/install.sh" --integrate
    ;;
  -h | --help)
    sed -n '3,7s/^# //p' "$0"
    exit 0
    ;;
esac

client="$(hyprctl -j clients 2>/dev/null | jq -c 'first(.[] | select(.class == "omaplex")) // empty')"

if [[ ${1:-} == reload-theme ]]; then
  # The running instance picks this up via Electron's single-instance handoff.
  [[ -n $client ]] && exec "$electron" "$dir" --reload-theme
  exit 0
fi

if [[ -z $client ]]; then
  [[ -n $electron ]] || { echo "omaplex: Electron not found (run npm install, or install the electron package)" >&2; exit 1; }
  [[ ${1:-} == toggle ]] && shift
  exec "$electron" "$dir" --class=omaplex --ozone-platform=wayland "$@"
fi

addr="$(jq -r .address <<<"$client")"
win="address:$addr"

if [[ ${1:-} != toggle ]]; then
  exec hyprctl dispatch "hl.dsp.focus({ window = \"$win\" })"
fi

if [[ $(jq -r .workspace.name <<<"$client") == special:omaplex ]]; then
  # Bring it back to wherever you are, re-pinning if the TV's PIN switch is on.
  ws="$(hyprctl -j activeworkspace | jq -r .id)"
  hyprctl dispatch "hl.dsp.window.move({ window = \"$win\", workspace = \"$ws\" })" >/dev/null
  if [[ $(jq -r '.pinned // true' "$state" 2>/dev/null) == true ]]; then
    hyprctl dispatch "hl.dsp.window.pin({ window = \"$win\", action = \"on\" })" >/dev/null
  fi
  hyprctl dispatch "hl.dsp.focus({ window = \"$win\" })" >/dev/null
else
  # Pinned windows can't live on a special workspace, so unpin before stashing.
  if [[ $(jq -r .pinned <<<"$client") == true ]]; then
    hyprctl dispatch "hl.dsp.window.pin({ window = \"$win\", action = \"off\" })" >/dev/null
  fi
  hyprctl dispatch "hl.dsp.window.move({ window = \"$win\", workspace = \"special:omaplex\", follow = false })" >/dev/null
fi
